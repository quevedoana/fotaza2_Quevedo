extends ../layout

block content
  div.container.mx-auto.px-4.py-8
    a.text-indigo-400.mb-4.inline-block(href='/publicaciones', class='hover:text-indigo-300')
      | &larr; Volver a todas las publicaciones

    if post
      div.bg-gray-800.rounded-lg.overflow-hidden

        if post.Photos && post.Photos.length > 0
          div.p-4
            div.relative.flex.items-center.justify-center

              button#prev.absolute.left-2.bg-gray-700.text-white.rounded-full.w-10.h-10.flex.items-center.justify-center(
                class='hover:bg-gray-600'
              ) &#8592;

              img#fotoActual.max-w-lg.mx-auto.block.rounded-lg.h-80.object-cover(
                src=post.Photos[0].imageSrc
                alt=post.title
              )

              button#next.absolute.right-2.bg-gray-700.text-white.rounded-full.w-10.h-10.flex.items-center.justify-center(
                class='hover:bg-gray-600'
              ) &#8594;

            p.text-center.text-gray-500.text-sm.mt-2
              span#indice 1
              |  / #{post.Photos.length}

        div.p-6

          h1.text-white.text-2xl.font-bold.mb-4= post.title

          p.text-gray-500.mb-4 Publicado por #{post.Author.userName}

          div.flex.items-center.gap-2.mb-4

            span.text-yellow-400.text-xl ★

            span.text-gray-300= `${promedio} / 5`

            span.text-gray-500.text-sm (#{post.Photos[0].Ratings.length} votos)
          if currentUser && currentUser.idUser !== post.idUser

            form(action=`/publicaciones/${post.idPost}/fotos/${post.Photos[0].idPhoto}/rating` method='POST')

              div.flex.gap-2.mb-4

                each n in [1,2,3,4,5]

                  button.text-2xl.text-yellow-600.transition(class="hover:text-yellow-100" type='submit' name='score' value=n) ★
          if post.description
            p.text-gray-400.mb-4= post.description

          if post.Tags && post.Tags.length > 0
            div.flex.flex-wrap.gap-2.mb-4

              each tag in post.Tags

                span.bg-gray-700.text-indigo-400.text-sm.px-3.py-1.rounded-full ##{tag.nameTag}

          div.mt-6

            h3.text-white.text-lg.font-semibold.mb-3 Comentarios

            if post.Photos[0].commentsActive

              form(action=`/publicaciones/${post.idPost}/fotos/${post.Photos[0].idPhoto}/comentarios` method='POST')

                div.flex.gap-2

                  input.flex-1.rounded.bg-gray-700.text-white.px-3.py-2(type='text' name='description' placeholder='Escribí un comentario...' required)

                  button.bg-indigo-600.text-white.rounded.px-4.py-2(class="hover:bg-indigo-700" type='submit') Comentar

              if currentUser && currentUser.idUser === post.idUser

                form.mt-2(action=`/publicaciones/${post.idPost}/fotos/${post.Photos[0].idPhoto}/comentarios/cerrar` method='POST')


                  button.text-rose-400.text-sm(class="hover:text-rose-300" type='submit') Cerrar comentarios

            else

              p.text-gray-500.text-sm Comentarios cerrados

              if currentUser && currentUser.idUser === post.idUser

                form.mt-2(action=`/publicaciones/${post.idPost}/fotos/${post.Photos[0].idPhoto}/comentarios/abrir` method='POST')


                  button.text-green-400.text-sm(class="hover:text-green-300" type='submit') Abrir comentarios

            div.mt-4.space-y-3

              each comment in post.Photos[0].Comments

                div.bg-gray-700.border.border-gray-600.rounded-lg.p-3(class="hover:border-indigo-500.transition")

                  div.flex.items-center.justify-between.mb-2

                    div.flex.items-center.gap-3

                      div.w-8.h-8.rounded-full.bg-indigo-600.flex.items-center.justify-center.text-white.font-semibold

                      div

                        p.text-indigo-400.font-semibold.text-sm= comment.Author.userName

                        p.text-gray-500.text-xs= new Date(comment.createdAt).toLocaleString('es-AR')

                  p.text-gray-100.text-sm.leading-relaxed= comment.description

          p.text-gray-500.text-sm.mt-6 Publicado el: #{new Date(post.createdAt).toLocaleDateString()}

            if currentUser && currentUser.idUser === post.idUser

              div.flex.gap-3.mt-6

                a.bg-indigo-600.text-gray-200.rounded.px-4.py-2(class="hover:bg-indigo-700" href=`/publicaciones/${post.idPost}/editar`) Editar

                form(action=`/publicaciones/${post.idPost}/eliminar` method='POST')

                  button.bg-rose-600.text-gray-200.rounded.px-4.py-2(class="hover:bg-rose-700" type='submit') Eliminar

    else
      div.bg-rose-900.text-rose-200.p-4.rounded
        p Publicación no encontrada

    script.
      var fotos = !{fotos};
      var actual = 0;

      function anterior() {
        actual = actual - 1;
        actual = actual < 0 ? fotos.length - 1 : actual;
        document.getElementById('fotoActual').src = fotos[actual];
        document.getElementById('indice').innerHTML = actual + 1;
      }

      function siguiente() {
        actual = actual + 1;
        actual = actual >= fotos.length ? 0 : actual;
        document.getElementById('fotoActual').src = fotos[actual];
        document.getElementById('indice').innerHTML = actual + 1;
      }

      var prevBtn = document.getElementById('prev');
      var nextBtn = document.getElementById('next');

      prevBtn.onclick = anterior;
      nextBtn.onclick = siguiente;

      var mostrarFlechas = fotos.length > 1;
      prevBtn.style.display = mostrarFlechas ? 'flex' : 'none';
      nextBtn.style.display = mostrarFlechas ? 'flex' : 'none';