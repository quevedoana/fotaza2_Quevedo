extends layout

block metadata
  title Inicio

block content

  a.fixed.bottom-6.right-6.bg-indigo-600.text-white.w-14.h-14.rounded-full.flex.items-center.justify-center.text-3xl.shadow-lg(
    href="/publicaciones/crear"
    class="hover:bg-indigo-700 transition-colors"
  ) +
  div.container.mx-auto.max-w-7xl.px-4.py-8

    if feed

      h1.text-white.text-4xl.font-bold.mb-2
        | Tu feed
     
      if !siguePersonas

        div.bg-gray-800.rounded-xl.p-6.mb-8

          p.text-gray-300.text-lg
            | Todavía no seguís a nadie.

          p.text-gray-500.mt-2
            | Mientras tanto te mostramos publicaciones para descubrir usuarios.

      else

        p.text-gray-400.mb-8
          | Publicaciones de las personas que seguís.
      
    else

      h1.text-white.text-4xl.font-bold.mb-2
        | Explorar publicaciones

      p.text-gray-400.mb-8
        | Descubrí contenido creado por la comunidad.

    if posts.length > 0

      div.max-w-3xl.mx-auto.space-y-8

        each post in posts

          div.bg-gray-800.rounded-xl.overflow-hidden.shadow-lg.transition-all.duration-200(
            class='hover:ring-2 hover:ring-indigo-500'
          )

            div.p-4.flex.items-center.justify-between.border-b.border-gray-700

              a.text-indigo-400.font-medium.no-underline(href=`/perfil/${post.Author.idUser}` class="hover:text-indigo-300")
                =  post.Author.userName

              span.text-gray-500.text-sm
                = new Date(post.createdAt).toLocaleDateString()

            a.block.no-underline(
              href=`/publicaciones/${post.idPost}`
            )

              if post.portada

                img.w-full.object-contain.bg-gray-900(
                  style="max-height:700px"
                  src=post.portada
                  alt=post.title
                )

              div.p-4

                h2.text-white.text-2xl.font-bold.mb-3
                  = post.title

                if post.description

                  p.text-gray-400.mb-4
                    = post.description

                div.flex.items-center.gap-6.text-sm.mb-4

                  if post.promedioRating

                    span.text-yellow-400
                      | ★ #{post.promedioRating}/5

                  else

                    span.text-gray-500
                      | ★ Sin valoraciones

                  

                if post.Tags && post.Tags.length > 0

                  div.flex.flex-wrap.gap-2.mb-4

                    each tag in post.Tags.slice(0, 5)

                      span.bg-gray-700.text-indigo-400.text-xs.px-2.py-1.rounded-full
                        | ##{tag.nameTag}



    else

      div.bg-gray-800.rounded-xl.p-10.text-center

        p.text-gray-300.text-xl
          | No hay publicaciones para mostrar.