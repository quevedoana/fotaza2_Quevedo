extends ../layout

block metadata
  title Resultados de búsqueda

block content

  div.container.mx-auto.max-w-7xl.px-4.py-8

    div.mb-10.text-center

      h1.text-white.text-4xl.font-bold.mb-2
        | Buscar publicaciones

      p.text-gray-400
        | Encontrá publicaciones por título, descripción, autor o etiquetas

    form.bg-gray-800.rounded-2xl.p-6.mb-8.shadow-lg(
      method="GET"
      action="/search"
    )

      div.grid.gap-4(
        class="grid-cols-1 md:grid-cols-4"
      )

        input.bg-gray-700.text-white.rounded-xl.p-3(
          type="text"
          name="q"
          placeholder="Buscar..."
          value=filtros.q
        )

        input.bg-gray-700.text-white.rounded-xl.p-3(
          type="text"
          name="autor"
          placeholder="Autor"
          value=filtros.autor
        )

        input.bg-gray-700.text-white.rounded-xl.p-3(
          type="text"
          name="tag"
          placeholder="Etiqueta"
          value=filtros.tag
        )

        select.bg-gray-700.text-white.rounded-xl.p-3(
          name="orden"
        )

          option(
            value="recientes"
            selected=filtros.orden === "recientes"
          ) Más recientes

          option(
            value="antiguas"
            selected=filtros.orden === "antiguas"
          ) Más antiguas

      div.mt-4.text-center

        button.bg-indigo-600.text-white.font-semibold.rounded-xl.px-8.py-3(
          type="submit"
          class="hover:bg-indigo-700"
        )
          | Buscar

    div.flex.justify-between.items-center.mb-6

      h2.text-white.text-2xl.font-bold
        | Resultados

      span.bg-indigo-600.text-white.text-sm.px-4.py-2.rounded-full
        | #{publicaciones.length}

    if publicaciones.length > 0

      div.grid.gap-6(
        class="grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
      )

        each post in publicaciones

          a.block.bg-gray-800.rounded-2xl.overflow-hidden.border.border-gray-700(
            href=`/publicaciones/${post.idPost}`
            class="hover:border-indigo-500 hover:-translate-y-1 transition-all duration-200"
          )

            if post.portada

              img.w-full.h-72.object-cover(
                src=post.portada
              )

            div.p-5

              h3.text-white.text-xl.font-bold.mb-2
                = post.title

              if post.description

                p.text-gray-400.text-sm.mb-3
                  = post.description

              div.flex.items-center.justify-between

                p.text-indigo-400.font-medium
                  = post.Author.userName

              if post.Tags.length > 0

                div.flex.flex-wrap.gap-2.mt-4

                  each tag in post.Tags

                    span.bg-gray-700.text-indigo-300.text-xs.px-3.py-1.rounded-full
                      | ##{tag.nameTag}

    else

      div.bg-gray-800.rounded-2xl.p-12.text-center


        h3.text-white.text-xl.font-semibold.mb-2
          | No se encontraron publicaciones

