doctype html
html(lang="es")

  head

    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")

    block metadata

    script(src="https://cdn.tailwindcss.com")

  body.bg-zinc-900

    header

      nav.flex.items-center.gap-6.bg-black.text-gray-400.h-14.px-4

        a.no-underline.text-white.font-bold.text-lg(
          href="/"
        ) Fotaza 2

        if currentUser

          a.text-gray-300.no-underline(
            href="/"
            class="hover:text-white"
          ) Inicio

          a.text-gray-300.no-underline(
            href="/publicaciones"
            class="hover:text-white"
          ) Publicaciones

          a.text-gray-300.no-underline(
            href=`/perfil/${currentUser.idUser}`
            class="hover:text-white"
          ) Mi Perfil

        form.flex.items-center.px-3.py-1.rounded-lg.bg-gray-800.ml-auto(
          action="/search"
          method="GET"
        )

          input.bg-transparent.border-0.text-white.outline-none(
            type="search"
            name="q"
            placeholder="Buscar..."
          )

        if currentUser

          span.text-gray-300.text-sm
            | Hola #{currentUser.userName}

          a.bg-rose-600.text-white.rounded-md.px-3.py-1.text-sm.no-underline(
            href="/logout"
            class="hover:bg-rose-700"
          ) Cerrar sesión

        else

          a.bg-indigo-600.text-white.rounded-md.px-3.py-1.text-sm.no-underline(
            href="/login"
            class="hover:bg-indigo-700"
          ) Iniciar sesión

          a.bg-indigo-600.text-white.rounded-md.px-3.py-1.text-sm.no-underline(
            href="/registro"
            class="hover:bg-indigo-700"
          ) Registrarse

    main

      block content

    block scripts