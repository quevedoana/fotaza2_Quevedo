doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")

    block metadata

    script(src="https://cdn.tailwindcss.com")

  body.bg-zinc-900

    header
      nav.flex.items-center.gap-8.bg-black.text-gray-400.h-12.px-3

        a.no-underline.text-white.font-semibold(
          href="/"
        ) Fotaza 2

        form.flex.items-center.px-3.rounded-lg.bg-gray-800.ml-auto(
          action="/search"
          method="GET"
        )
          input.bg-transparent.border-0.text-white.outline-none(
            type="search"
            name="q"
            placeholder="Buscar..."
          )

        if currentUser

          span.text-gray-300.text-sm
            | Hola #{currentUser.userName}

          a.bg-rose-600.text-white.rounded-md.px-3.py-1.text-sm.no-underline(class="hover:bg-rose-700" href="/logout") Cerrar sesión

        else

          a.bg-indigo-600.text-white.rounded-md.px-3.py-1.text-sm.no-underline(class="hover:bg-indigo-700" href="/login") Iniciar sesión

          a.bg-indigo-600.text-white.rounded-md.px-3.py-1.text-sm.no-underline(class="hover:bg-indigo-700" href="/registro") Registrarse

    main
      block content

    block scripts  




